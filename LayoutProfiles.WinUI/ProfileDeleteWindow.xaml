<Window
    x:Class="LayoutProfiles.WinUI.ProfileDeleteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="RootGrid" Padding="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="0" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="12" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border
            x:Name="ProfileBadge"
            Width="44"
            Height="44"
            CornerRadius="22"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
          <TextBlock
              x:Name="ProfileInitial"
              FontSize="18"
              FontWeight="SemiBold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock
              x:Name="ProfileNameText"
              FontSize="18"
              FontWeight="SemiBold"
              TextTrimming="CharacterEllipsis" />
          <TextBlock
              x:Name="ProfileMetaText"
              FontSize="12" />
        </StackPanel>
      </StackPanel>

      <TextBlock
          x:Name="HeadingText"
          FontSize="20"
          FontWeight="SemiBold"
          Text="Delete profile?" />

      <TextBlock
          x:Name="MessageText"
          FontSize="13"
          TextWrapping="WrapWholeWords"
          Text="This cannot be undone." />
    </StackPanel>

    <StackPanel
        Grid.Row="1"
        Orientation="Horizontal"
        HorizontalAlignment="Right"
        Spacing="8"
        Margin="0,12,0,0">
      <Button
          x:Name="CancelButton"
          MinWidth="88"
          Content="Cancel"
          Click="OnCancelClick" />
      <Button
          x:Name="DeleteButton"
          MinWidth="88"
          Content="Delete"
          Click="OnDeleteClick" />
    </StackPanel>
  </Grid>
</Window>
