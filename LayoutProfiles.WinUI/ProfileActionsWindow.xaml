<Window
    x:Class="LayoutProfiles.WinUI.ProfileActionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
      Padding="24"
      Background="#FF1E1E1E">
    <StackPanel x:Name="ActionsPanel" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border
            x:Name="ProfileBadge"
            Width="44"
            Height="44"
            CornerRadius="22"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
          <TextBlock
              x:Name="ProfileInitial"
              FontSize="18"
              FontWeight="SemiBold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock
              x:Name="ProfileNameText"
              FontSize="18"
              FontWeight="SemiBold"
              Foreground="#FFF0F2F5"
              TextTrimming="CharacterEllipsis" />
          <TextBlock
              x:Name="ProfileMetaText"
              FontSize="12"
              Foreground="#FF9AA3AD" />
        </StackPanel>
      </StackPanel>
      <Button
          Content="Edit layout"
          HorizontalAlignment="Stretch"
          Click="OnEditClick" />
      <Button
          Content="Update layout"
          HorizontalAlignment="Stretch"
          Click="OnUpdateClick" />
      <Button
          Content="Delete profile"
          HorizontalAlignment="Stretch"
          Click="OnDeleteClick" />
      <Button
          Content="Close"
          HorizontalAlignment="Right"
          Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
