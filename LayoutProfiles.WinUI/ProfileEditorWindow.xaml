<Window
    x:Class="LayoutProfiles.WinUI.ProfileEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
      x:Name="RootGrid"
      Padding="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="0" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
        x:Name="HeadingText"
        Grid.Row="0"
        Margin="0,0,0,14"
        FontSize="20"
        FontWeight="SemiBold" />

    <StackPanel
        Grid.Row="1"
        Spacing="8">
      <TextBlock
          x:Name="NameLabelText"
          Text="Profile name"
          FontSize="13"
          Opacity="0.75" />
      <TextBox
          x:Name="NameBox"
          MaxLength="120"
          PlaceholderText="e.g. League" />
    </StackPanel>

    <StackPanel
        Grid.Row="2"
        Spacing="4"
        Margin="0,18,0,8">
      <TextBlock
          x:Name="ApplicationsLabelText"
          Text="Applications"
          FontSize="13"
          FontWeight="SemiBold"
          Opacity="0.85" />
      <TextBlock
          x:Name="WindowsHintText"
          FontSize="12"
          Opacity="0.75"
          TextWrapping="WrapWholeWords"
          Text="Select windows to include in this layout." />
    </StackPanel>

    <ScrollViewer
        x:Name="WindowListScroll"
        Grid.Row="3"
        MinHeight="120"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollMode="Auto"
        HorizontalScrollMode="Disabled"
        ZoomMode="Disabled">
      <ItemsControl x:Name="WindowList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox
                MinHeight="40"
                Padding="4,6"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsChecked="{Binding IsChecked, Mode=TwoWay}">
              <TextBlock
                  Text="{Binding DisplayText}"
                  TextWrapping="WrapWholeWords"
                  TextTrimming="CharacterEllipsis"
                  MaxLines="2" />
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock
        x:Name="EmptyWindowsText"
        Grid.Row="4"
        FontSize="12"
        Margin="0,8,0,0"
        Text="No pickable windows found. Open the apps you want, then click Refresh."
        TextWrapping="WrapWholeWords"
        Visibility="Collapsed" />

    <TextBlock
        x:Name="ErrorText"
        Grid.Row="5"
        FontSize="12"
        Foreground="#FFE06C75"
        Margin="0,8,0,0"
        TextWrapping="WrapWholeWords"
        Visibility="Collapsed" />

    <StackPanel
        Grid.Row="6"
        Orientation="Horizontal"
        HorizontalAlignment="Right"
        Spacing="8"
        Margin="0,12,0,0">
      <Button
          x:Name="CancelButton"
          Content="Cancel"
          Click="OnCancelClick" />
      <Button
          x:Name="RefreshButton"
          Content="Refresh"
          Click="OnRefreshClick" />
      <Button
          x:Name="SaveButton"
          Content="Save"
          Style="{StaticResource AccentButtonStyle}"
          Click="OnSaveClick" />
    </StackPanel>
  </Grid>
</Window>
