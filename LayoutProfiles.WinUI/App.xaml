<Application
    x:Class="LayoutProfiles.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#66282828" />
      <SolidColorBrush x:Key="WidgetOpaqueChromeBrush" Color="#FF282828" />
      <SolidColorBrush x:Key="WidgetPrimaryBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="WidgetBorderBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="WidgetMutedBrush" Color="#FFB3B3B3" />
      <SolidColorBrush x:Key="WidgetAccentBrush" Color="#FF4C8BF5" />
      <SolidColorBrush x:Key="WidgetAddChipBackgroundBrush" Color="#33FFFFFF" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
