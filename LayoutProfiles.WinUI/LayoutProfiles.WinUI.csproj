<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LayoutProfiles.WinUI</RootNamespace>
    <AssemblyName>Snapdesk</AssemblyName>
    <Product>Snapdesk</Product>
    <AssemblyTitle>Snapdesk</AssemblyTitle>
    <Version>1.0.15</Version>
    <UseAppHost>true</UseAppHost>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Default false for design-time/AnyCPU project load; enable only for real x64 builds. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Bundle WinApp SDK 1.6 next to the exe so a separate MSIX runtime install is not required. -->
    <WindowsAppSDKSelfContained Condition="'$(Platform)' == 'x64'">true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapAutoInitializeOptions>OnNoMatch_ShowUI</WindowsAppSdkBootstrapAutoInitializeOptions>
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackage>false</AppxPackage>
    <!-- Unpackaged: avoid MrtCore PRI tasks (ExpandPriContent needs VS Appx MSBuild DLLs). -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <EnablePriGenTooling>false</EnablePriGenTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <GeneratePri>false</GeneratePri>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon Condition="Exists('..\assets\app_icon.ico')">..\assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

</Project>
